{
  "name": "ahv13-validator",
  "version": "2.0.1",
  "description": "Validates the AHV 13 Number (Swiss social security number)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longstone/js-ahv13.git"
  },
  "bugs": {
    "url": "https://github.com/longstone/js-ahv13/issues"
  },
  "homepage": "https://github.com/longstone/js-ahv13#readme",
  "license": "ISC",
  "keywords": [
    "AHV13",
    "SSN",
    "Switzerland",
    "validator"
  ],
  "author": "longstone <contact@longstone.ch>",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --sourcemap --clean --target es2020 && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "cov": "vitest run --coverage",
    "doc": "typedoc",
    "fix": "npm run format && npm run lint:fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint src vitest.config.ts",
    "lint:fix": "eslint src vitest.config.ts --fix",
    "prepack": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
